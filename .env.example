# ---- Copy to .env and change every secret before going live ----

HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

POSTGRES_DB=pdfconvert
POSTGRES_USER=pdfconvert
POSTGRES_PASSWORD=change-me-strong-password

# Long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret
# Set to true when served over HTTPS
COOKIE_SECURE=false

# First admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# Defaults (admin can change these later in Admin > Settings)
GUEST_FREE_CREDITS=3
SIGNUP_FREE_CREDITS=20
MAX_FILE_MB=50
MAX_PAGES=300
# How long converted files are kept (hours)
GUEST_FILE_TTL_HOURS=24
USER_FILE_TTL_HOURS=168

# How many PDFs are converted in parallel
QUEUE_CONCURRENCY=2
CONVERTER_WORKERS=2

# Telegram: users are sent to t.me/<username> to ask for more credits
TELEGRAM_ADMIN_USERNAME=your_telegram_username
# Optional: bot that pings the admin when a new credit request arrives
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
