# ==============================================================================
# DIGITECHKH PDF CONVERTER - PRODUCTION CONFIGURATION
# ==============================================================================
# cp .env.example .env   then change every value marked CHANGE.
# This file holds secrets: never commit it (it is git-ignored).
# Generate a secret:  openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# HOST PORT
# ------------------------------------------------------------------------------
# Gateway port on the server (BMS uses 4600, so 4900 does not collide)
PORT_HTTP=4900
# 0.0.0.0 = reachable from the network. Use 127.0.0.1 when only a tunnel / reverse proxy
# on this same server talks to it (Cloudflare Tunnel, host nginx, Caddy): safer.
BIND_ADDRESS=0.0.0.0

# Public address people open (used in Telegram links to the admin panel)
PUBLIC_URL=https://pdf.digitechkh.site
# true when the site is served over HTTPS (Cloudflare Tunnel, Caddy, Certbot). false for plain http://IP:4900
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# DATABASE (the SAME PostgreSQL server as BMS, but its OWN database + user)
# ------------------------------------------------------------------------------
# BMS reaches it at host.docker.internal:5434; keep the same host/port as BMS's .env.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5434
# its own user: NOT the BMS user (setup-database.sh sets this user's password)
POSTGRES_DB=pdf_convertor_db
POSTGRES_USER=pdf_convertor
# CHANGE. Letters and digits only (it goes inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ------------------------------------------------------------------------------
# SECURITY (CHANGE all three)
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-openssl-rand-hex-32
COOKIE_SECRET=change-me-openssl-rand-hex-32

# First admin account, created on first start if it does not exist (sign in, then /admin)
ADMIN_EMAIL=admin@digitechkh.site
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=DIGITECHKH Admin

# ------------------------------------------------------------------------------
# CREDITS & LIMITS (defaults: the admin can change them later in Admin > Settings)
# ------------------------------------------------------------------------------
GUEST_FREE_CREDITS=3
SIGNUP_FREE_CREDITS=20
# guest conversions allowed per IP address per day
GUEST_IP_DAILY_CAP=10
MAX_FILE_MB=50
MAX_PAGES=300
# how long converted files are kept (hours)
GUEST_FILE_TTL_HOURS=24
USER_FILE_TTL_HOURS=168

# ------------------------------------------------------------------------------
# PERFORMANCE (raise on a bigger server)
# ------------------------------------------------------------------------------
# PDFs converted at the same time
QUEUE_CONCURRENCY=2
CONVERTER_WORKERS=2
# memory cap for the converter container (OCR of big scans needs 2-3 GB)
CONVERTER_MEM_LIMIT=3g

# ------------------------------------------------------------------------------
# TELEGRAM
# ------------------------------------------------------------------------------
# users are sent to t.me/<username> to ask for more credits
TELEGRAM_ADMIN_USERNAME=digitechkh
# optional: a bot that messages the admin when a new credit request arrives
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
